FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src
COPY api/ ./
RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -o /out/arkive ./cmd/server

FROM alpine:3.21
RUN apk add --no-cache ca-certificates wget \
    && adduser -D -H -u 65532 arkive
WORKDIR /app
COPY --from=builder /out/arkive /app/arkive
COPY api/migrations /app/migrations
RUN mkdir -p /data/arkive && chown -R arkive:arkive /app /data/arkive
ENV ARKIVE_MIGRATIONS_DIR=/app/migrations
USER arkive
EXPOSE 8080
ENTRYPOINT ["/app/arkive"]

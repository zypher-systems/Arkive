# TLS at Caddy. Point DNS at this host, then:
#   caddy run --config deploy/Caddyfile
#
# The Arkive container is published on host port 3080 (container 8080).
# Set on the arkive service:
#   ARKIVE_PUBLIC_URL=https://arkive.example.com
#   ARKIVE_COOKIE_SECURE=true
#   ARKIVE_TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12   (prod overlay default)
# Arkive only reads X-Forwarded-For from trusted proxy addresses.
#
# Outer body-size limit should match ARKIVE_MAX_UPLOAD_BYTES (default 10 GiB).
# Replace X-Forwarded-For — do not append a client-supplied value.

arkive.example.com {
	encode gzip

	request_body {
		max_size 10GB
	}

	reverse_proxy 127.0.0.1:3080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}

		transport http {
			read_timeout 3600s
			write_timeout 3600s
		}
	}
}

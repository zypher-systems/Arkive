# Copy to .env and adjust for your deployment. Everything here is optional for
# a local try-out: `docker compose up -d` works without a .env file.
# Docker Compose loads .env from the project root automatically.
#
# Layouts:
#   SQLite (default, one container):  docker compose up -d
#   PostgreSQL (arkive + postgres):   docker compose -f docker-compose.postgres.yml up -d
#   Production: add -f docker-compose.prod.yml (requires ARKIVE_PUBLIC_URL,
#   and POSTGRES_PASSWORD with PostgreSQL)
#
# Upgrading a 1.0 install? It uses PostgreSQL: uncomment the next line.
# COMPOSE_FILE=docker-compose.postgres.yml
# (production: COMPOSE_FILE=docker-compose.postgres.yml:docker-compose.prod.yml)
#
# UI + API + WebDAV: http://localhost:3080  (single arkive container)
# First run: docker compose logs arkive | grep setup_token
# Named volumes: arkive_data (/data/arkive: files, .arkive-secrets and the
# SQLite database arkive.db); postgres_data with the PostgreSQL layout —
# back up everything together.
# TLS belongs on an outer reverse proxy — see deploy/.

ARKIVE_PUBLIC_URL=http://localhost:3080
ARKIVE_COOKIE_SECURE=false
# Host port for the app (default 3080). Use 127.0.0.1:3080 to accept only a local proxy.
# ARKIVE_PORT=3080

# Secrets: leave unset to generate strong values on first boot, stored in
# /data/arkive/.arkive-secrets. If you set them, use long random values
# (openssl rand -base64 32). Production refuses the old placeholders.
# ARKIVE_SESSION_SECRET=
# ARKIVE_SECRETS_KEY=

# First-run setup token. Unset = a one-time token is printed to the log.
# ARKIVE_SETUP_TOKEN=

# Optional: this email becomes instance admin when it registers or logs in.
# ARKIVE_BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Reverse proxies whose X-Forwarded-For / X-Real-IP are trusted (CIDRs or IPs,
# comma-separated). Default: none — the connecting address is the client.
# The prod overlay defaults to 127.0.0.1/32,172.16.0.0/12.
# ARKIVE_TRUSTED_PROXIES=

# Prometheus metrics at /metrics (404 unless enabled). Set a token when the
# port is reachable from outside: scrape with "Authorization: Bearer <token>".
# ARKIVE_METRICS_ENABLED=false
# ARKIVE_METRICS_TOKEN=

# Default blob dir inside the container (Compose volume arkive_data)
# ARKIVE_DATA_DIR=/data/arkive

# Database. Unset = SQLite at $ARKIVE_DATA_DIR/arkive.db (docker-compose.yml).
# docker-compose.postgres.yml sets it for you. Examples:
#   ARKIVE_DATABASE_URL=sqlite:///data/arkive/arkive.db
#   ARKIVE_DATABASE_URL=postgres://arkive:secret@db.example.com:5432/arkive?sslmode=require
# ARKIVE_DATABASE_URL=

# Arkive refuses to start on an empty database when the data dir already
# holds Arkive files (protects 1.0 upgrades). Only set this to start anyway.
# ARKIVE_ALLOW_NONEMPTY_DATA_DIR=false

# Optional remote S3 default instead of the local folder
# ARKIVE_S3_ENDPOINT=
# ARKIVE_S3_ACCESS_KEY=
# ARKIVE_S3_SECRET_KEY=
# ARKIVE_S3_BUCKET=

# Postgres password for docker-compose.postgres.yml (dev default "arkive";
# set it for production). Only takes effect when the database volume is first
# created.
# POSTGRES_PASSWORD=

# Max upload size in bytes (default 10 GiB)
ARKIVE_MAX_UPLOAD_BYTES=10737418240

# Optional OIDC — set all three to enable SSO
# ARKIVE_OIDC_ISSUER=https://your-idp.example.com
# ARKIVE_OIDC_CLIENT_ID=arkive
# ARKIVE_OIDC_CLIENT_SECRET=secret
# ARKIVE_OIDC_PROVIDER_NAME=SSO

# Optional Google Drive OAuth override (preferred: Admin → Google Drive OAuth)
# When set, these win over DB settings.
# ARKIVE_GOOGLE_CLIENT_ID=
# ARKIVE_GOOGLE_CLIENT_SECRET=
# ARKIVE_GOOGLE_REDIRECT_URL=http://localhost:3080/api/auth/google/drive/callback

# Optional SMTP for signup approve/reject emails (or Admin → SMTP)
# ARKIVE_SMTP_HOST=smtp.example.com
# ARKIVE_SMTP_PORT=587
# ARKIVE_SMTP_USER=
# ARKIVE_SMTP_PASSWORD=
# ARKIVE_SMTP_FROM=Arkive <noreply@example.com>

# WebDAV: mount http://localhost:3080/dav/<workspace-id>/ with email + password
# (copy URLs from Account → WebDAV mount).
